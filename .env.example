# Copie a .env y complete. Sin LLM_API_KEY la app funciona en modo local (determinista).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Alternativas compatibles con OpenAI: NVIDIA NIM (https://integrate.api.nvidia.com/v1) u Ollama (http://localhost:11434/v1)
AGENT_T_MAX=6
RAG_BACKEND=tfidf
# SOCRATA_APP_TOKEN=   (opcional, evita límites de la API de datos.gov.co)
